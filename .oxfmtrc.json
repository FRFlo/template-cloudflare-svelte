{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"singleQuote": false,
	"trailingComma": "all",
	"printWidth": 100,
	"sortTailwindcss": {
		"stylesheet": "./src/routes/layout.css"
	},
	"sortPackageJson": false,
	"ignorePatterns": [
		"package-lock.json",
		"pnpm-lock.yaml",
		"yarn.lock",
		"bun.lock",
		"bun.lockb",
		".svelte-kit/",
		"node_modules/",
		"src/lib/paraglide/**",
		"worker-configuration.d.ts"
	]
}
